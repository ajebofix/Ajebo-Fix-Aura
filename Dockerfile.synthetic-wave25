FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["sh", "-c", "flask db upgrade && python scripts/seed_wave_2_5_synthetic_cohort.py && python scripts/validate_wave_2_5_synthetic_cohort.py --format json && sleep 3600"]
